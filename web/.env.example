# Copier en .env.local et remplir. Les chemins sont relatifs au dossier web/
# (on peut aussi coller directement le contenu PEM / JSON).

# Adresse publique du site, en https en production (ex. https://app.qamar.fr)
PUBLIC_URL=http://localhost:3000

# ——— Apple Wallet (compte Apple Developer) ———
# Identifiant du "Pass Type ID" créé dans Certificates, Identifiers & Profiles
APPLE_PASS_TYPE_ID=pass.com.qamar.fidelite
# Team ID (10 caractères, visible dans Membership)
APPLE_TEAM_ID=XXXXXXXXXX
# Certificat du Pass Type ID et sa clé privée (PEM), + certificat Apple WWDR G4
APPLE_PASS_CERT=certs/pass.pem
APPLE_PASS_KEY=certs/pass.key
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=certs/wwdr-g4.pem
# false = ne pas envoyer de vraies notifications (tests locaux)
APPLE_PUSH_ENABLED=true

# ——— Google Wallet (Google Pay & Wallet Console + Google Cloud) ———
GOOGLE_WALLET_ISSUER_ID=
# Fichier JSON de la clé du compte de service
GOOGLE_SERVICE_ACCOUNT=certs/google-service-account.json
# false = ne pas appeler l'API Google (tests locaux)
GOOGLE_WALLET_API_ENABLED=true

# ——— Abonnement (Stripe) ———
# Clé secrète (sk_live_… en production, sk_test_… pour tester)
STRIPE_SECRET_KEY=
# Prix récurrents (price_…) : mensuel 25 € HT obligatoire, annuel 250 € HT facultatif
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_YEARLY=
# Clé de signature du webhook (whsec_…), donnée par Stripe quand on déclare /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Jours d'essai gratuit avant le premier prélèvement (14 par défaut, 0 = aucun)
TRIAL_DAYS=14

# ——— Tâches du matin (anniversaires, relance des clients absents) ———
# Secret attendu par /api/cron/daily (en-tête « Authorization: Bearer … »).
# Appeler cette adresse une fois par jour vers 10 h (Vercel Cron, cron du serveur…).
CRON_SECRET=

# Adresse de contact publique (pages /aide et /confidentialite, fiche App Store).
CONTACT_EMAIL=

# ——— E-mails (« Code oublié ») : compte Resend, domaine vérifié (SPF + DKIM chez OVH) ———
RESEND_API_KEY=
# Expéditeur, ex. Qamar <no-reply@qamar-conception.fr>
MAIL_FROM=

# ——— Informations légales (mentions légales, CGV) : affichées « [à compléter] » tant qu'elles manquent ———
LEGAL_COMPANY=
LEGAL_FORM=
LEGAL_SIREN=
LEGAL_VAT=
LEGAL_ADDRESS=
LEGAL_DIRECTOR=
LEGAL_COURT_CITY=

# ——— Sécurité ———
# Relais à sauter en fin de X-Forwarded-For pour trouver l'adresse du visiteur (1 derrière Render + Cloudflare).
# Sans effet si Cloudflare fournit CF-Connecting-IP.
TRUSTED_PROXY_HOPS=1
# Origine web autorisée à appeler l'API en production (vide = aucune ; l'appli iPhone / Android n'en a pas besoin)
CORS_ORIGINS=
